DATABASE_URL="file:./dev.db"
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# Numero de proxies na frente do servidor (nginx, Cloudflare...).
# Deixe 0 quando o servidor recebe as conexoes diretamente: ligar sem proxy
# real permite que o cliente forje o proprio IP e escape do limite de taxa.
TRUST_PROXY=0
